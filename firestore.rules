rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for UserSearch
    function isValidUserSearch(data) {
      return data.keys().hasAll(['userId', 'pokemonName', 'timestamp']) 
        && data.keys().size() == 3
        && data.userId == request.auth.uid
        && data.pokemonName is string && data.pokemonName.size() <= 100
        && data.timestamp == request.time;
    }

    // Validation for ChatHistory
    function isValidChatHistory(data) {
      return data.keys().hasAll(['userId', 'role', 'text', 'timestamp'])
        && data.keys().size() == 4
        && data.userId == request.auth.uid
        && data.role in ['user', 'model']
        && data.text is string && data.text.size() <= 5000
        && data.timestamp == request.time;
    }

    // User Searches Collection
    match /user_searches/{searchId} {
      allow create: if isSignedIn() && isValidUserSearch(request.resource.data);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Chat History Subcollection
    match /users/{userId}/chat_history/{messageId} {
      allow create: if isOwner(userId) && isValidChatHistory(request.resource.data);
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
    }
  }
}
